generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Post {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  content   String?  @default("")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Creators {
  id               BigInt    @id @default(autoincrement())
  creatorName      String    @default("")
  creatorDesc      String?   @default("")
  creatorThumbnail String?   @default("")
  creatorTags      String[]
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime? @db.Timestamptz(6)
  Art              Art[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Art {
  id              BigInt    @id @default(autoincrement())
  url             String
  startingPrice   Int
  currentPrice    Int
  buyoutPrice     Int
  bidCount        Int?      @default(0) @db.SmallInt
  isAuctionActive Boolean?  @default(false)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  sellerId        BigInt?
  winnerId        BigInt?
  artTitle        String?
  auctionEndAt    DateTime? @db.Timestamp(6)
  artCreatedAt    DateTime  @db.Date
  artSize         String
  artMaterial     String
  artDesc         String
  Creators        Creators? @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
